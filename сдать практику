// ========== Observer ==========
class IObserver {
public:
    virtual void onEvent(const std::string& event) = 0;
    virtual ~IObserver() = default;
};

class BattleLogger : public IObserver {
public:
    void onEvent(const std::string& event) override {
        std::cout << "[LOG] " << event << std::endl;
    }
};

class AttackCounter : public IObserver {
private:
    int counter = 0;

public:
    void onEvent(const std::string& event) override {
        counter++;
        std::cout << "[COUNTER] Событий атаки: " << counter << std::endl;
    }

    int getCount() const {
        return counter;
    }
};

// ========== Bridge: Abstraction (кто атакует) ==========
class ICharacter {
protected:
    std::vector<IObserver*> observers;

public:
    virtual void attack() = 0;
    virtual ~ICharacter() = default;

    void subscribe(IObserver* obs) {
        observers.push_back(obs);
    }

protected:
    void notify(const std::string& event) {
        for (auto* obs : observers) {
            obs->onEvent(event);
        }
    }
};

// Пример: Воин (может использовать любую атаку)
class Warrior : public ICharacter {
private:
    std::unique_ptr<IAttack> attackImpl;
    std::string name;

public:
    Warrior(std::unique_ptr<IAttack> atk)
        : name("Воин"), attackImpl(std::move(atk)) {
        std::cout << "Создан персонаж: " << name << std::endl;
    }

    void attack() override {
        std::cout << name << " атакует! ";
        attackImpl->attack();
        notify("ATTACK: Воин использует атаку");
    }
};

