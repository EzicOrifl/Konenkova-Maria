// ========== Proxy для SecretCharacter ==========
// TODO: Реализовать SecretCharacterProxy
// - Должен реализовывать интерфейс ICharacter
// - Хранить: int currentLevel, int requiredLevel = 10
// - Хранить: std::unique_ptr<SecretCharacter> real
// - Хранить: std::unique_ptr<IAttack> attackImpl (атака для секретного персонажа)
// - В методе attack() проверять уровень
// - Если уровень достаточный -> создать real и делегировать
// - Если нет -> вывести сообщение об ошибке

class SecretCharacterProxy : public ICharacter {
private:
    int currentLevel;
    const int requiredLevel = 10;
    std::unique_ptr<SecretCharacter> real;
    std::unique_ptr<IAttack> attackImpl;
    
public:
    SecretCharacterProxy(int level, std::unique_ptr<IAttack> atk)
        : currentLevel(level), attackImpl(std::move(atk)) {
        std::cout << " создан прокси для секретного персонажа (уровень: " 
                  << currentLevel << ")" << std::endl;
    }
    
    void attack() override {
        if (currentLevel >= requiredLevel) {
            if (!real) {
                real = std::make_unique<SecretCharacter>(std::move(attackImpl));
            }
            real->attack();
        } else {
            std::cout << "ошибка: недостаточный уровень! текущий уровень: " 
                      << currentLevel << ", требуется: " << requiredLevel << std::endl;
        }
    }
};

