// ========== Bridge: Implementation (как атакует) ==========
class IAttack {
public:
    virtual void attack() = 0;
    virtual ~IAttack() = default;
};

// Пример: атака мечом
class SwordAttack : public IAttack {
public:
    void attack() override {
        std::cout << "Удар мечом! Нанесено 50 урона!" << std::endl;
    }
};

