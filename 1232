// ========== Bridge: Abstraction (кто атакует) ==========
class ICharacter {
public:
    virtual void attack() = 0;
    virtual ~ICharacter() = default;
};

// Пример: Воин (может использовать любую атаку)
class Warrior : public ICharacter {
private:
    std::unique_ptr<IAttack> attackImpl;
    std::string name;

public:
    Warrior(std::unique_ptr<IAttack> atk)
        : name("Воин"), attackImpl(std::move(atk)) {
        std::cout << "Создан персонаж: " << name << std::endl;
    }

    void attack() override {
        std::cout << name << " атакует! ";
        attackImpl->attack();
    }
};

